<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block direct access to sensitive application directories & dotfiles if deployed in public_html root
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|tests|vendor)(/|$) - [F,L]
    RewriteRule ^(\.env|\.git|composer\.(json|lock)|package(-lock)?\.json|artisan|vite\.config\.js) - [F,L]

    # Block direct client requests containing /public prefix to prevent directory exposure and scanner fuzzing
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /+public [NC]
    RewriteRule ^ - [F,L]

    # Run robots.txt through Laravel so its response includes the application headers.
    RewriteRule ^robots\.txt$ public/index.php [L]

    # Block bare directory requests from triggering Apache mod_dir redirect inflation
    RewriteRule ^(images|uploads|blank|tutorial|js|css|public)/?$ - [F,L]
    RewriteRule ^public/(images|uploads|blank|tutorial|js|css)/?$ - [F,L]

    # Discard query strings on static assets to prevent scanners from fuzzing static file versions
    RewriteCond %{QUERY_STRING} .
    RewriteCond %{REQUEST_URI} \.(js|css|png|jpe?g|gif|ico|svg|webp|txt|xml)$ [NC]
    RewriteRule ^(.*)$ $1? [L]

    # Route all requests cleanly to the public/ directory
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L,QSA]
</IfModule>

<IfModule mod_headers.c>
    # Server-generated errors bypass Laravel's nonce-based policy.
    Header always set Content-Security-Policy "default-src 'none'; script-src 'none'; style-src 'none'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'" "expr=%{REQUEST_STATUS} >= 400"

    # Security headers for root requests & static fallback (set on both tables for 200 OK and error responses)
    Header set X-Content-Type-Options "nosniff"
    Header always set X-Content-Type-Options "nosniff"
    Header set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header set X-Frame-Options "DENY"
    Header always set X-Frame-Options "DENY"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "camera=(self), microphone=(), geolocation=()"
    Header always set Permissions-Policy "camera=(self), microphone=(), geolocation=()"

    # Caching directives and security headers for static sitemaps, robots, and xml
    <FilesMatch "\.(xml|txt)$">
        Header set X-Content-Type-Options "nosniff"
        Header always set X-Content-Type-Options "nosniff"
        Header set Strict-Transport-Security "max-age=31536000; includeSubDomains"
        Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
        Header set Cache-Control "max-age=86400, public, must-revalidate"
    </FilesMatch>

    # Restrict CORS headers to application origin on static assets to prevent Cross-Domain Misconfiguration
    <FilesMatch "\.(png|jpe?g|gif|ico|svg|webp|js|css|xml|txt)$">
        Header set Access-Control-Allow-Origin "https://lawngreen-lyrebird-493319.hostingersite.com"
        Header always set Access-Control-Allow-Origin "https://lawngreen-lyrebird-493319.hostingersite.com"
        Header set Access-Control-Allow-Methods "GET, OPTIONS"
        Header always set Access-Control-Allow-Methods "GET, OPTIONS"
    </FilesMatch>
</IfModule>

# A plain error document needs no inline scripts or styles.
ErrorDocument 403 "Forbidden"

Options -Indexes
