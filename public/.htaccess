<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Let PHP emit a bodyless HTTPS redirect before Laravel or static files are served.
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1|\[::1\])(:[0-9]+)?$ [NC]
    RewriteRule ^(?!index\.php$) index.php [L]

    # Route this existing file through Laravel instead of serving it without middleware.
    RewriteRule ^robots\.txt$ index.php [L]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Block bare directory requests from triggering Apache mod_dir redirect inflation
    RewriteRule ^(images|uploads|blank|tutorial|js|css|public)/?$ - [F,L]

    # Discard query strings on static assets to prevent scanners from fuzzing static file versions
    RewriteCond %{QUERY_STRING} .
    RewriteCond %{REQUEST_URI} \.(js|css|png|jpe?g|gif|ico|svg|webp|txt|xml)$ [NC]
    RewriteRule ^(.*)$ $1? [L]

    # Block access to hidden files and directories
    RewriteRule "(^|/)\." - [F]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

<IfModule mod_headers.c>
    # Server-generated errors bypass Laravel's nonce-based policy.
    Header always set Content-Security-Policy "default-src 'none'; script-src 'none'; style-src 'none'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'" "expr=%{REQUEST_STATUS} >= 400"

    # Security headers applied to all responses (including static files like images and robots.txt)
    Header set X-Content-Type-Options "nosniff"
    Header always set X-Content-Type-Options "nosniff"
    Header set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header set X-Frame-Options "DENY"
    Header always set X-Frame-Options "DENY"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "camera=(self), microphone=(), geolocation=()"
    Header always set Permissions-Policy "camera=(self), microphone=(), geolocation=()"

    # Caching directives and security headers for static sitemaps, robots, and xml
    <FilesMatch "\.(xml|txt)$">
        Header set X-Content-Type-Options "nosniff"
        Header always set X-Content-Type-Options "nosniff"
        Header set Strict-Transport-Security "max-age=31536000; includeSubDomains"
        Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
        Header set Cache-Control "max-age=86400, public, must-revalidate"
    </FilesMatch>

    # Restrict CORS headers to application origin on static assets to prevent Cross-Domain Misconfiguration
    <FilesMatch "\.(png|jpe?g|gif|ico|svg|webp|js|css|xml|txt)$">
        Header set Access-Control-Allow-Origin "https://lawngreen-lyrebird-493319.hostingersite.com"
        Header always set Access-Control-Allow-Origin "https://lawngreen-lyrebird-493319.hostingersite.com"
        Header set Access-Control-Allow-Methods "GET, OPTIONS"
        Header always set Access-Control-Allow-Methods "GET, OPTIONS"
    </FilesMatch>
</IfModule>

ErrorDocument 403 "Forbidden"
