APP_NAME=RPMEIS
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pme_v2_1
DB_USERNAME=root
DB_PASSWORD=

LEGACY_DB_HOST=${DB_HOST}
LEGACY_DB_PORT=${DB_PORT}
LEGACY_DB_DATABASE=${DB_DATABASE}
LEGACY_DB_USERNAME=${DB_USERNAME}
LEGACY_DB_PASSWORD=${DB_PASSWORD}

PMC_API_URL=https://127.0.0.1:8000/api
PMC_API_TOKEN=
PME_SYNC_SECRET=

SESSION_DRIVER=file
SESSION_LIFETIME=15
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@philarmy-pme.mil.ph"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
