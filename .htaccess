<IfModule mod_rewrite.c>
    RewriteEngine On

    # Enforce HTTPS across all incoming HTTP requests immediately
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP_HOST} !^localhost [NC]
    RewriteCond %{HTTP_HOST} !^127\.0\.0\.1
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Block direct access to sensitive application directories & dotfiles if deployed in public_html root
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|tests|vendor)(/|$) - [F,L]
    RewriteRule ^(\.env|\.git|composer\.(json|lock)|package(-lock)?\.json|artisan|vite\.config\.js) - [F,L]

    # Block direct directory traversal to avoid Apache mod_dir 301 redirects with body inflation (Big Redirect Detected)
    RewriteCond %{REQUEST_URI} !^/?$
    RewriteCond %{REQUEST_URI} !^/public/?$
    RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -d [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [F,L]

    # Route all requests cleanly to the public/ directory
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L,QSA]
</IfModule>

<IfModule mod_headers.c>
    # Security headers for root requests & static fallback
    Header always set X-Content-Type-Options "nosniff"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(self), microphone=(), geolocation=()"

    # Caching directives for static sitemaps, robots, and xml
    <FilesMatch "\.(xml|txt)$">
        Header set Cache-Control "max-age=86400, public, must-revalidate"
    </FilesMatch>

    # Remove overly permissive CORS headers on static assets
    <FilesMatch "\.(png|jpe?g|gif|ico|svg|webp)$">
        Header unset Access-Control-Allow-Origin
        Header always unset Access-Control-Allow-Origin
        Header unset Access-Control-Allow-Methods
        Header always unset Access-Control-Allow-Methods
    </FilesMatch>
    Header unset Access-Control-Allow-Origin
    Header always unset Access-Control-Allow-Origin
    Header unset Access-Control-Allow-Methods
    Header always unset Access-Control-Allow-Methods
</IfModule>

Options -Indexes
